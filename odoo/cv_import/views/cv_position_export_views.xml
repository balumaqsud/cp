<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cv_position_export_wizard_view_form" model="ir.ui.view">
        <field name="name">cv.position.export.wizard.form</field>
        <field name="model">cv.position.export.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="base_url"/>
                    <field name="title"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="title"/>
                        <field name="type"/>
                    </list>
                </field>
                <footer>
                    <button name="action_export" type="object" string="Export" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cv_position_export" model="ir.actions.act_window">
        <field name="name">Export</field>
        <field name="res_model">cv.position.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_cv_export_wizard" name="Export" parent="menu_cv_import_root" action="action_cv_position_export" sequence="30"/>
</odoo>
