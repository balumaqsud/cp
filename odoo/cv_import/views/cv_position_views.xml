<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cv_position_view_list" model="ir.ui.view">
        <field name="name">cv.position.list</field>
        <field name="model">cv.position</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="title"/>
                <field name="published_cv_count"/>
                <field name="imported_at"/>
            </list>
        </field>
    </record>

    <record id="cv_position_view_form" model="ir.ui.view">
        <field name="name">cv.position.form</field>
        <field name="model">cv.position</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <field name="title"/>
                        <field name="published_cv_count"/>
                        <field name="imported_at"/>
                    </group>
                    <field name="attribute_ids">
                        <list create="false" edit="false" delete="false">
                            <field name="title"/>
                            <field name="type"/>
                            <field name="result"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cv_position" model="ir.actions.act_window">
        <field name="name">Imported positions</field>
        <field name="res_model">cv.position</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_cv_import_root" name="CV import" sequence="80"/>
    <menuitem id="menu_cv_position" name="Positions" parent="menu_cv_import_root" action="action_cv_position" sequence="10"/>
</odoo>
