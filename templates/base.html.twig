<!DOCTYPE html>
<html lang="{{ app.request.locale }}" data-bs-theme="{{ app.request.attributes.get('_theme', 'light') }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}{{ 'nav.brand'|trans }}{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body class="d-flex flex-column min-vh-100">
        {% set theme = app.request.attributes.get('_theme', 'light') %}
        <nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom">
            <div class="container">
                <a class="navbar-brand" href="{{ path('app_home') }}">{{ 'nav.brand'|trans }}</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-nav" aria-controls="main-nav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="main-nav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_home') }}">{{ 'nav.home'|trans }}</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_position_index') }}">{{ 'nav.positions'|trans }}</a>
                        </li>
                        {% if is_granted('ATTRIBUTE_MANAGE') %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_attribute_index') }}">{{ 'nav.attributes'|trans }}</a>
                            </li>
                        {% endif %}
                        {% if is_granted('CV_LIST') %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_cv_index') }}">{{ 'nav.cvs'|trans }}</a>
                            </li>
                        {% endif %}
                        {% if is_granted('USER_MANAGE') %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_admin_users') }}">{{ 'nav.users'|trans }}</a>
                            </li>
                        {% endif %}
                        {% if app.user %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_profile') }}">{{ 'nav.profile'|trans }}</a>
                            </li>
                        {% endif %}
                    </ul>
                    <form class="d-flex me-lg-3 mb-2 mb-lg-0" action="{{ path('app_search') }}" method="get" role="search">
                        <input class="form-control form-control-sm" type="search" name="q" value="{{ app.request.query.get('q') }}" placeholder="{{ 'nav.search_placeholder'|trans }}" aria-label="{{ 'nav.search'|trans }}">
                    </form>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <a class="btn btn-sm {{ app.request.locale == 'en' ? 'btn-secondary' : 'btn-outline-secondary' }}" href="{{ path('app_locale', {locale: 'en'}) }}" data-turbo="false">{{ 'locale.en'|trans }}</a>
                        <a class="btn btn-sm {{ app.request.locale == 'uz' ? 'btn-secondary' : 'btn-outline-secondary' }}" href="{{ path('app_locale', {locale: 'uz'}) }}" data-turbo="false">{{ 'locale.uz'|trans }}</a>
                        {% if theme == 'dark' %}
                            <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_theme', {theme: 'light'}) }}" data-turbo="false">{{ 'theme.light'|trans }}</a>
                        {% else %}
                            <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_theme', {theme: 'dark'}) }}" data-turbo="false">{{ 'theme.dark'|trans }}</a>
                        {% endif %}
                        {% if app.user %}
                            <span class="navbar-text small">{{ app.user.userIdentifier }}</span>
                            <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_logout') }}">{{ 'nav.logout'|trans }}</a>
                        {% else %}
                            <a class="btn btn-outline-primary btn-sm" href="{{ path('app_login') }}">{{ 'nav.login'|trans }}</a>
                            <a class="btn btn-primary btn-sm" href="{{ path('app_register') }}">{{ 'nav.register'|trans }}</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </nav>
        <main class="container py-4 flex-grow-1">
            {% for type, messages in app.flashes %}
                {% set alertClass = type == 'error' or type == 'danger' ? 'danger' : type %}
                {% for message in messages %}
                    <div class="alert alert-{{ alertClass }} alert-dismissible fade show" role="alert">
                        {{ message|trans }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endfor %}
            {% block body %}{% endblock %}
        </main>
        {% if app.user %}
            {% set ticketFrom = app.request.attributes.get('_route') == 'app_support_ticket'
                ? app.request.query.get('from', app.request.uri)
                : app.request.uri %}
            <footer class="border-top py-3">
                <div class="container d-flex align-items-center gap-2">
                    <a class="link-secondary" href="{{ path('app_support_ticket', {from: ticketFrom}) }}" aria-label="{{ 'support.help'|trans }}">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                            <path d="M5.255 5.786a.237.237 0 0 0 .241.247h.825c.138 0 .248-.113.266-.25.09-.656.54-1.134 1.342-1.134.686 0 1.314.343 1.314 1.168 0 .635-.374.927-.965 1.371-.673.489-1.206 1.06-1.168 1.987l.003.217a.25.25 0 0 0 .25.246h.811a.25.25 0 0 0 .25-.25v-.105c0-.718.273-.927 1.01-1.486.609-.463 1.244-.977 1.244-2.056 0-1.511-1.276-2.241-2.673-2.241-1.267 0-2.655.59-2.75 2.286m1.557 5.763c0 .533.425.927 1.01.927.609 0 1.028-.394 1.028-.927 0-.552-.42-.94-1.029-.94-.584 0-1.009.388-1.009.94"/>
                        </svg>
                    </a>
                    <a class="link-secondary small" href="{{ path('app_support_ticket', {from: ticketFrom}) }}">{{ 'support.link'|trans }}</a>
                </div>
            </footer>
        {% endif %}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    </body>
</html>
