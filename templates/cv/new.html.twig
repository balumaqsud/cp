{% extends 'base.html.twig' %}

{% block title %}{{ 'cv.generate'|trans }}{% endblock %}

{% block body %}
    <h1 class="h4 mb-3">{{ 'cv.generate'|trans }}</h1>
    <p class="text-muted">{{ 'cv.generate_help'|trans }}</p>

    <form method="post" action="{{ path('app_cv_generate') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('cv_generate') }}">
        {% include 'partials/_toolbar.html.twig' with {
            actions: [
                { value: 'generate', label: 'cv.generate' },
            ],
        } %}

        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th scope="col" class="text-nowrap" style="width: 2rem;">
                            <span class="visually-hidden">{{ 'table.select'|trans }}</span>
                        </th>
                        <th>{{ 'position.title'|trans }}</th>
                        <th>{{ 'position.company'|trans }}</th>
                        <th>{{ 'position.level'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% if positions is empty %}
                        <tr>
                            <td colspan="4" class="text-muted">{{ 'table.empty'|trans }}</td>
                        </tr>
                    {% else %}
                        {% for position in positions %}
                            <tr>
                                <td>
                                    <input class="form-check-input" type="checkbox" name="ids[]" value="{{ position.id }}">
                                </td>
                                <td>{{ position.title }}</td>
                                <td>{{ position.company ?? '—' }}</td>
                                <td>{{ position.level ?? '—' }}</td>
                            </tr>
                        {% endfor %}
                    {% endif %}
                </tbody>
            </table>
        </div>
    </form>
{% endblock %}
