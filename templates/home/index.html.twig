{% extends 'base.html.twig' %}

{% block title %}{{ 'home.title'|trans }}{% endblock %}

{% block body %}
    <div class="text-center py-5">
        <h1>{{ 'home.title'|trans }}</h1>
        <p class="text-muted">{{ 'home.lead'|trans }}</p>

        {% if app.user %}
            <p>{{ 'home.signed_in'|trans({ '%email%': app.user.userIdentifier }) }}</p>
        {% else %}
            <a class="btn btn-primary" href="{{ path('app_login') }}">{{ 'nav.login'|trans }}</a>
            <a class="btn btn-outline-secondary" href="{{ path('app_register') }}">{{ 'nav.register'|trans }}</a>
        {% endif %}
    </div>
{% endblock %}
