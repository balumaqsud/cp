{% extends 'base.html.twig' %}

{% block title %}Course project{% endblock %}

{% block body %}
    <div class="text-center py-5">
        <h1>Course project</h1>
        <p class="text-muted">App is running.</p>

        {% if app.user %}
            <p>Signed in as {{ app.user.userIdentifier }}.</p>
        {% else %}
            <a class="btn btn-primary" href="{{ path('app_login') }}">Log in</a>
            <a class="btn btn-outline-secondary" href="{{ path('app_register') }}">Sign up</a>
        {% endif %}
    </div>
{% endblock %}
