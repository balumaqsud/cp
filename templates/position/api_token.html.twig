{% extends 'base.html.twig' %}

{% block title %}{{ 'position.api_token.heading'|trans }}{% endblock %}

{% block body %}
    <h1 class="h4 mb-3">{{ 'position.api_token.heading'|trans }}</h1>
    <p class="text-muted small">{{ 'position.api_token.help'|trans }}</p>

    <div class="col-lg-8">
        <label class="form-label" for="api-token">{{ 'position.api_token.heading'|trans }}</label>
        <input id="api-token" class="form-control font-monospace" type="text" value="{{ position.apiToken }}" readonly>

        <p class="mt-3 mb-1"><code>GET {{ app.request.schemeAndHttpHost ~ '/api/positions' }}</code></p>
        <p class="mb-3"><code>Authorization: Bearer {{ position.apiToken }}</code></p>

        <form method="post" action="{{ path('app_position_api_token', {id: position.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('position_api_token') }}">
            <button type="submit" class="btn btn-outline-secondary btn-sm">{{ 'position.api_token.regenerate'|trans }}</button>
            <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_position_edit', {id: position.id}) }}">{{ 'attribute.cancel'|trans }}</a>
        </form>
    </div>
{% endblock %}
