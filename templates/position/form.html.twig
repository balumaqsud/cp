{% extends 'base.html.twig' %}

{% block title %}{{ position.id ? 'position.edit'|trans : 'position.create'|trans }}{% endblock %}

{% block body %}
    {% set filterPath = position.id ? path('app_position_edit', {id: position.id}) : path('app_position_new') %}
    {% set visibleIds = [] %}
    {% for attribute in recentAttributes|default([]) %}
        {% set visibleIds = visibleIds|merge([attribute.id]) %}
    {% endfor %}
    {% for attribute in filteredLibrary %}
        {% set visibleIds = visibleIds|merge([attribute.id]) %}
    {% endfor %}

    <h1 class="h4 mb-3">{{ position.id ? 'position.edit'|trans : 'position.create'|trans }}</h1>

    <form method="get" action="{{ filterPath }}" class="row g-2 mb-3">
        <div class="col-md-4">
            <label class="visually-hidden" for="attribute-prefix">{{ 'attribute.filter_prefix'|trans }}</label>
            <input id="attribute-prefix" class="form-control form-control-sm" type="search" name="prefix" value="{{ prefix }}" placeholder="{{ 'attribute.filter_prefix'|trans }}">
        </div>
        <div class="col-md-4">
            <label class="visually-hidden" for="attribute-category">{{ 'attribute.category'|trans }}</label>
            <select id="attribute-category" class="form-select form-select-sm" name="category">
                <option value="">{{ 'attribute.category_all'|trans }}</option>
                {% for category in categories %}
                    <option value="{{ category.id }}" {{ categoryId == category.id ? 'selected' }}>{{ category.name }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-2">
            <button class="btn btn-outline-secondary btn-sm" type="submit">{{ 'attribute.filter'|trans }}</button>
        </div>
    </form>

    {{ form_start(form) }}
        <div class="row">
            <div class="col-lg-6">
                {{ form_row(form.title) }}
                {{ form_row(form.shortDescription) }}
                {{ form_row(form.company) }}
                {{ form_row(form.level) }}
                {{ form_row(form.isPublic) }}
                <div class="mb-3" data-controller="tags">
                    {{ form_label(form.projectTagsText) }}
                    {{ form_widget(form.projectTagsText, {
                        attr: {
                            'data-tags-target': 'input',
                            class: 'd-none',
                        }
                    }) }}
                    <div class="d-flex flex-wrap gap-1 mb-2" data-tags-target="chips"></div>
                    <input
                        class="form-control"
                        type="text"
                        data-tags-target="entry"
                        data-action="keydown->tags#add blur->tags#blur"
                        list="project-tag-suggestions"
                        autocomplete="off"
                        placeholder="{{ 'project.tags_placeholder'|trans }}"
                    >
                    <datalist id="project-tag-suggestions">
                        {% for tag in tagSuggestions %}
                            <option value="{{ tag }}"></option>
                        {% endfor %}
                    </datalist>
                    <div class="form-text">{{ 'project.tags_help'|trans }}</div>
                    {{ form_errors(form.projectTagsText) }}
                </div>
                {{ form_row(form.maxProjects) }}
                {{ form_row(form.version) }}
            </div>
        </div>

        {% for id in selectedIds %}
            {% if id not in visibleIds %}
                <input type="hidden" name="attribute_ids[]" value="{{ id }}">
                {% if requiredById[id]|default(false) %}
                    <input type="hidden" name="attribute_required[{{ id }}]" value="1">
                {% endif %}
            {% endif %}
        {% endfor %}

        <h2 class="h5 mt-4">{{ 'position.template'|trans }}</h2>
        <p class="text-muted small">{{ 'position.template_help'|trans }}</p>

        {% if recentAttributes is not empty %}
            <h3 class="h6">{{ 'attribute.recent'|trans }}</h3>
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>{{ 'position.include'|trans }}</th>
                            <th>{{ 'attribute.name'|trans }}</th>
                            <th>{{ 'attribute.type'|trans }}</th>
                            <th>{{ 'position.required'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for attribute in recentAttributes %}
                            {% include 'position/_attribute_row.html.twig' %}
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}

        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>{{ 'position.include'|trans }}</th>
                        <th>{{ 'attribute.name'|trans }}</th>
                        <th>{{ 'attribute.type'|trans }}</th>
                        <th>{{ 'position.required'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% if filteredLibrary is empty %}
                        <tr>
                            <td colspan="4" class="text-muted">{{ 'table.empty'|trans }}</td>
                        </tr>
                    {% endif %}
                    {% for attribute in filteredLibrary %}
                        {% include 'position/_attribute_row.html.twig' %}
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <h2 class="h5 mt-4">{{ 'position.access_rules'|trans }}</h2>
        <p class="text-muted small">{{ 'position.access_rules_help'|trans }}</p>
        <div data-controller="collection">
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>{{ 'attribute.name'|trans }}</th>
                            <th>{{ 'position.operator'|trans }}</th>
                            <th>{{ 'position.compare_value'|trans }}</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody data-collection-target="list">
                        {% for index, rule in rules %}
                            {% include 'position/_rule_row.html.twig' with { index: index, rule: rule, library: library, operators: operators } %}
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <template>
                {% include 'position/_rule_row.html.twig' with { index: '__index__', rule: { attributeId: '', operator: 'eq', compareValue: '' }, library: library, operators: operators } %}
            </template>
            <button type="button" class="btn btn-outline-secondary btn-sm" data-action="collection#add">{{ 'position.add_rule'|trans }}</button>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">{{ 'attribute.save'|trans }}</button>
            <a class="btn btn-outline-secondary" href="{{ path('app_position_index') }}">{{ 'attribute.cancel'|trans }}</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
