{% extends 'base.html.twig' %}

{% block title %}{{ position.title }}{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h1 class="h4 mb-1">{{ position.title }}</h1>
            {% if position.company or position.level %}
                <p class="text-muted mb-0">
                    {{ position.company }}
                    {% if position.company and position.level %} · {% endif %}
                    {{ position.level }}
                </p>
            {% endif %}
        </div>
        <div class="d-flex gap-2">
            {% if canManage %}
                <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_position_edit', {id: position.id}) }}">{{ 'position.edit'|trans }}</a>
            {% endif %}
            {% if canGenerate %}
                {% if existingCv %}
                    <a class="btn btn-primary btn-sm" href="{{ path('app_cv_show', {id: existingCv.id}) }}">{{ 'cv.open'|trans }}</a>
                {% else %}
                    <form method="post" action="{{ path('app_cv_generate') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('cv_generate') }}">
                        <input type="hidden" name="position_id" value="{{ position.id }}">
                        <button type="submit" class="btn btn-primary btn-sm">{{ 'cv.generate'|trans }}</button>
                    </form>
                {% endif %}
            {% endif %}
        </div>
    </div>

    <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-template" type="button">{{ 'position.template'|trans }}</button>
        </li>
        {% if is_granted('CV_LIST') %}
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-cvs" type="button">{{ 'cv.heading'|trans }}</button>
            </li>
        {% endif %}
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-discussion" type="button">{{ 'position.discussion'|trans }}</button>
        </li>
    </ul>

    <div class="tab-content border border-top-0 p-3">
        <div class="tab-pane fade show active" id="tab-template">
            {% if position.shortDescription %}
                <p>{{ position.shortDescription }}</p>
            {% endif %}
            <p class="small text-muted">
                {{ 'position.public'|trans }}:
                {{ position.public ? 'attribute.yes'|trans : 'attribute.no'|trans }}
            </p>
            <h2 class="h6">{{ 'position.template'|trans }}</h2>
            <ul class="list-unstyled">
                {% for positionAttribute in position.positionAttributes %}
                    <li>
                        {{ positionAttribute.attribute ? positionAttribute.attribute.name : '—' }}
                        {% if positionAttribute.required %}
                            <span class="badge text-bg-secondary">{{ 'position.required'|trans }}</span>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
            {% if position.projectTags %}
                <p class="small mb-0">{{ 'position.project_tags'|trans }}: {{ position.projectTags|join(', ') }}</p>
            {% endif %}
        </div>

        {% if is_granted('CV_LIST') %}
            <div class="tab-pane fade" id="tab-cvs">
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>{{ 'cv.candidate'|trans }}</th>
                                <th>{{ 'cv.status'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% if publishedCvs is empty %}
                                <tr>
                                    <td colspan="2" class="text-muted">{{ 'table.empty'|trans }}</td>
                                </tr>
                            {% else %}
                                {% for cv in publishedCvs %}
                                    <tr>
                                        <td>
                                            <a href="{{ path('app_cv_show', {id: cv.id}) }}">{{ cv.user ? cv.user.name : '—' }}</a>
                                        </td>
                                        <td>{{ ('cv.status_' ~ cv.status)|trans }}</td>
                                    </tr>
                                {% endfor %}
                            {% endif %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% endif %}

        <div class="tab-pane fade" id="tab-discussion">
            <div
                data-controller="poll"
                data-poll-url-value="{{ path('app_position_discussion', {id: position.id}) }}"
                data-poll-interval-value="3000"
            >
                {% include 'position/_posts.html.twig' with { posts: posts } %}
            </div>

            {% if canDiscuss %}
                <div class="mt-3 col-lg-8">
                    {{ form_start(discussionForm) }}
                        {{ form_row(discussionForm.content) }}
                        <button type="submit" class="btn btn-primary btn-sm">{{ 'position.post'|trans }}</button>
                    {{ form_end(discussionForm) }}
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
