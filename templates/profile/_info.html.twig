<p class="text-muted small">{{ 'profile.info_help'|trans }}</p>

{% if canEdit %}
    <form method="post" action="{{ path('app_profile_info', {id: profileUser.id}) }}" class="mb-3">
        <input type="hidden" name="_token" value="{{ csrf_token('profile_info') }}">
        <div class="d-flex flex-wrap gap-2 mb-3">
            <select class="form-select form-select-sm" name="attribute_id" style="max-width: 18rem;">
                <option value="">{{ 'profile.choose_attribute'|trans }}</option>
                {% for attribute in availableAttributes %}
                    <option value="{{ attribute.id }}">{{ attribute.name }}</option>
                {% endfor %}
            </select>
            <button type="submit" name="toolbar_action" value="add" class="btn btn-primary btn-sm">{{ 'profile.add_attribute'|trans }}</button>
            <button
                type="submit"
                name="toolbar_action"
                value="remove"
                class="btn btn-outline-danger btn-sm"
                onclick="return confirm({{ 'profile.confirm_remove_attributes'|trans|json_encode|raw }})"
            >{{ 'profile.remove_attribute'|trans }}</button>
            <button type="submit" class="btn btn-outline-secondary btn-sm" form="profile-values">{{ 'attribute.save'|trans }}</button>
        </div>

        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th scope="col" class="text-nowrap" style="width: 2rem;">
                            <span class="visually-hidden">{{ 'table.select'|trans }}</span>
                        </th>
                        <th>{{ 'attribute.name'|trans }}</th>
                        <th>{{ 'attribute.type'|trans }}</th>
                        <th>{{ 'profile.value'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% if infoAttributes is empty %}
                        <tr>
                            <td colspan="4" class="text-muted">{{ 'table.empty'|trans }}</td>
                        </tr>
                    {% else %}
                        {% for attribute in infoAttributes %}
                            <tr>
                                <td>
                                    <input class="form-check-input" type="checkbox" name="ids[]" value="{{ attribute.id }}">
                                </td>
                                <td>{{ attribute.name }}</td>
                                <td>{{ ('attribute.types.' ~ attribute.type)|trans }}</td>
                                <td>
                                    {% include 'profile/_value_field.html.twig' with {
                                        attribute: attribute,
                                        row: values[attribute.id]|default(null),
                                        canEdit: canEdit,
                                        form_id: 'profile-values',
                                    } %}
                                </td>
                            </tr>
                        {% endfor %}
                    {% endif %}
                </tbody>
            </table>
        </div>
    </form>
{% else %}
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>{{ 'attribute.name'|trans }}</th>
                    <th>{{ 'profile.value'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% if infoAttributes is empty %}
                    <tr>
                        <td colspan="2" class="text-muted">{{ 'table.empty'|trans }}</td>
                    </tr>
                {% else %}
                    {% for attribute in infoAttributes %}
                        <tr>
                            <td>{{ attribute.name }}</td>
                            <td>
                                {% include 'profile/_value_field.html.twig' with {
                                    attribute: attribute,
                                    row: values[attribute.id]|default(null),
                                    canEdit: false,
                                } %}
                            </td>
                        </tr>
                    {% endfor %}
                {% endif %}
            </tbody>
        </table>
    </div>
{% endif %}
