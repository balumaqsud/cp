<p class="text-muted small">{{ 'profile.me_help'|trans }}</p>

{% if canEdit %}
    <div class="mb-3">
        <button type="submit" class="btn btn-primary btn-sm" form="profile-values">{{ 'attribute.save'|trans }}</button>
    </div>
{% endif %}

<div class="row g-3 col-lg-8">
    {% for attribute in builtIns %}
        <div class="col-12">
            <label class="form-label">{{ attribute.name }}</label>
            {% include 'profile/_value_field.html.twig' with {
                attribute: attribute,
                row: values[attribute.id]|default(null),
                canEdit: canEdit,
                form_id: 'profile-values',
            } %}
        </div>
    {% else %}
        <p class="text-muted mb-0">{{ 'table.empty'|trans }}</p>
    {% endfor %}
</div>
