{% set current = row ? row.value : null %}
<div class="{% if mark_empty|default(false) and attribute.id in emptyIds|default([]) %}cv-field-empty rounded p-1{% endif %}">

{% if not canEdit %}
    {% if attribute.type == 'boolean' %}
        {{ current ? 'attribute.yes'|trans : 'attribute.no'|trans }}
    {% elseif attribute.type == 'period' %}
        {{ current is iterable ? current.from|default('—') : '—' }}
        –
        {{ current is iterable ? current.to|default('—') : '—' }}
    {% elseif attribute.type == 'image' and current %}
        <img src="{{ current }}" alt="{{ attribute.name }}" class="img-fluid" style="max-height: 80px;">
    {% elseif attribute.type == 'text' and current %}
        <div class="markdown-body">{{ current|markdown_to_html }}</div>
    {% else %}
        {{ current ?? '—' }}
    {% endif %}
{% else %}
    <input type="hidden" name="values[{{ attribute.id }}][version]" value="{{ row ? row.version : '' }}"{% if form_id is defined %} form="{{ form_id }}"{% endif %}>

    {% if attribute.type == 'boolean' %}
        <input type="hidden" name="values[{{ attribute.id }}][value]" value="0"{% if form_id is defined %} form="{{ form_id }}"{% endif %}>
        <input class="form-check-input" type="checkbox" name="values[{{ attribute.id }}][value]" value="1" {{ current ? 'checked' }}{% if form_id is defined %} form="{{ form_id }}"{% endif %}>
    {% elseif attribute.type == 'text' %}
        <textarea class="form-control form-control-sm" rows="4" name="values[{{ attribute.id }}][value]"{% if form_id is defined %} form="{{ form_id }}"{% endif %}>{{ current }}</textarea>
    {% elseif attribute.type == 'numeric' %}
        <input class="form-control form-control-sm" type="number" step="any" name="values[{{ attribute.id }}][value]" value="{{ current }}"{% if form_id is defined %} form="{{ form_id }}"{% endif %}>
    {% elseif attribute.type == 'date' %}
        <input class="form-control form-control-sm" type="date" name="values[{{ attribute.id }}][value]" value="{{ current }}"{% if form_id is defined %} form="{{ form_id }}"{% endif %}>
    {% elseif attribute.type == 'period' %}
        <div class="d-flex gap-2">
            <input class="form-control form-control-sm" type="date" name="values[{{ attribute.id }}][from]" value="{{ current is iterable ? current.from|default('') : '' }}"{% if form_id is defined %} form="{{ form_id }}"{% endif %}>
            <input class="form-control form-control-sm" type="date" name="values[{{ attribute.id }}][to]" value="{{ current is iterable ? current.to|default('') : '' }}"{% if form_id is defined %} form="{{ form_id }}"{% endif %}>
        </div>
    {% elseif attribute.type == 'choice' %}
        <select class="form-select form-select-sm" name="values[{{ attribute.id }}][value]"{% if form_id is defined %} form="{{ form_id }}"{% endif %}>
            <option value="">—</option>
            {% for option in attribute.options %}
                <option value="{{ option }}" {{ current == option ? 'selected' }}>{{ option }}</option>
            {% endfor %}
        </select>
    {% elseif attribute.type == 'image' %}
        {% set cloudName = cloudinary_cloud_name|default('') %}
        {% set uploadPreset = cloudinary_upload_preset|default('') %}
        <div
            data-controller="image-upload"
            data-image-upload-cloud-value="{{ cloudName }}"
            data-image-upload-preset-value="{{ uploadPreset }}"
            data-image-upload-uploading-value="{{ 'attribute.image_uploading'|trans }}"
            data-image-upload-failed-value="{{ 'attribute.image_failed'|trans }}"
        >
            <input
                class="form-control form-control-sm"
                type="url"
                name="values[{{ attribute.id }}][value]"
                value="{{ current }}"
                placeholder="https://"
                data-image-upload-target="input"
                {% if form_id is defined %} form="{{ form_id }}"{% endif %}
            >
            {% if cloudName and uploadPreset %}
                <div
                    class="border rounded p-3 mt-2 text-center small text-muted"
                    data-action="dragover->image-upload#dragover drop->image-upload#drop"
                >
                    {{ 'attribute.image_drop'|trans }}
                    <input class="form-control form-control-sm mt-2" type="file" accept="image/*" data-action="change->image-upload#pick">
                </div>
                <div class="form-text" data-image-upload-target="status"></div>
            {% endif %}
            <img
                src="{{ current ?: '' }}"
                alt="{{ attribute.name }}"
                class="img-fluid mt-2 {{ current ? '' : 'd-none' }}"
                style="max-height: 80px;"
                data-image-upload-target="preview"
            >
        </div>
    {% else %}
        <input class="form-control form-control-sm" type="text" name="values[{{ attribute.id }}][value]" value="{{ current }}"{% if form_id is defined %} form="{{ form_id }}"{% endif %}>
    {% endif %}
{% endif %}
</div>
