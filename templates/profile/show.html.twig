{% extends 'base.html.twig' %}

{% block title %}{{ 'profile.heading'|trans }}{% endblock %}

{% block body %}
    <h1 class="h4 mb-3">{{ 'profile.heading'|trans }}</h1>

    <dl class="row mb-0">
        <dt class="col-sm-3">{{ 'profile.name'|trans }}</dt>
        <dd class="col-sm-9">{{ profileUser.name }}</dd>
        <dt class="col-sm-3">{{ 'profile.email'|trans }}</dt>
        <dd class="col-sm-9">{{ profileUser.email }}</dd>
    </dl>
{% endblock %}
