{% extends 'base.html.twig' %}

{% block title %}{{ 'profile.heading'|trans }}{% endblock %}

{% block body %}
    {% if canEdit %}
    <div
        data-controller="autosave"
        data-autosave-interval-value="8000"
        data-autosave-unsaved-value="{{ 'profile.autosave.unsaved'|trans }}"
        data-autosave-saving-value="{{ 'profile.autosave.saving'|trans }}"
        data-autosave-saved-value="{{ 'profile.autosave.saved'|trans }}"
    >
    {% endif %}
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
                <h1 class="h4 mb-1">{{ 'profile.heading'|trans }}</h1>
                <p class="text-muted mb-0">
                    {{ profileUser.name }}
                    {% if not isPublicView|default(false) %}
                        · {{ profileUser.email }}
                    {% endif %}
                </p>
            </div>
            {% if canEdit %}
                <small class="text-muted" data-autosave-target="status"></small>
            {% endif %}
        </div>

        {% if canEdit %}
            <form
                id="profile-values"
                method="post"
                action="{{ path('app_profile_values', {id: profileUser.id}) }}"
                data-autosave-target="form"
            >
                <input type="hidden" name="_token" value="{{ csrf_token('profile_values') }}">
                <input type="hidden" name="tab" value="{{ tab }}" data-autosave-target="tab">
            </form>
        {% endif %}

        <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item">
                <button
                    class="nav-link {{ tab == 'me' ? 'active' }}"
                    data-bs-toggle="tab"
                    data-bs-target="#tab-me"
                    data-profile-tab="me"
                    {% if canEdit %}data-action="click->autosave#switchTab"{% endif %}
                    type="button"
                >{{ 'profile.tab.me'|trans }}</button>
            </li>
            <li class="nav-item">
                <button
                    class="nav-link {{ tab == 'info' ? 'active' }}"
                    data-bs-toggle="tab"
                    data-bs-target="#tab-info"
                    data-profile-tab="info"
                    {% if canEdit %}data-action="click->autosave#switchTab"{% endif %}
                    type="button"
                >{{ 'profile.tab.info'|trans }}</button>
            </li>
            <li class="nav-item">
                <button
                    class="nav-link {{ tab == 'projects' ? 'active' }}"
                    data-bs-toggle="tab"
                    data-bs-target="#tab-projects"
                    data-profile-tab="projects"
                    {% if canEdit %}data-action="click->autosave#switchTab"{% endif %}
                    type="button"
                >{{ 'profile.tab.projects'|trans }}</button>
            </li>
            <li class="nav-item">
                <button
                    class="nav-link {{ tab == 'cvs' ? 'active' }}"
                    data-bs-toggle="tab"
                    data-bs-target="#tab-cvs"
                    data-profile-tab="cvs"
                    {% if canEdit %}data-action="click->autosave#switchTab"{% endif %}
                    type="button"
                >{{ 'profile.tab.cvs'|trans }}</button>
            </li>
        </ul>

        <div class="tab-content border border-top-0 p-3">
            <div class="tab-pane fade {{ tab == 'me' ? 'show active' }}" id="tab-me">
                {% include 'profile/_me.html.twig' %}
            </div>
            <div class="tab-pane fade {{ tab == 'info' ? 'show active' }}" id="tab-info">
                {% include 'profile/_info.html.twig' %}
            </div>
            <div class="tab-pane fade {{ tab == 'projects' ? 'show active' }}" id="tab-projects">
                {% include 'profile/_projects.html.twig' %}
            </div>
            <div class="tab-pane fade {{ tab == 'cvs' ? 'show active' }}" id="tab-cvs">
                {% include 'profile/_cvs.html.twig' %}
            </div>
        </div>
    {% if canEdit %}
    </div>
    {% endif %}
{% endblock %}
