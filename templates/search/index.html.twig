{% extends 'base.html.twig' %}

{% block title %}{{ 'search.heading'|trans }}{% endblock %}

{% block body %}
    <h1 class="h4 mb-3">{{ 'search.heading'|trans }}</h1>

    {% if query is empty and tag is empty %}
        <p class="text-muted">{{ 'search.prompt'|trans }}</p>
    {% else %}
        {% if tag is not empty %}
            <p class="text-muted">{{ 'search.tag'|trans({ '%tag%': tag }) }}</p>
        {% endif %}

        <h2 class="h6 mt-4">{{ 'search.positions'|trans }}</h2>
        {% include 'position/_link_table.html.twig' with {
            positions: results.positions,
            empty_label: 'search.empty',
        } %}

        {% if is_granted('CV_LIST') %}
            <h2 class="h6 mt-4">{{ 'search.cvs'|trans }}</h2>
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>{{ 'cv.candidate'|trans }}</th>
                            <th>{{ 'cv.position'|trans }}</th>
                            <th>{{ 'cv.likes'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if results.cvs is empty %}
                            <tr>
                                <td colspan="3" class="text-muted">{{ 'search.empty'|trans }}</td>
                            </tr>
                        {% else %}
                            {% for cv in results.cvs %}
                                <tr>
                                    <td>
                                        <a href="{{ path('app_cv_show', {id: cv.id}) }}">{{ cv.user ? cv.user.name : '—' }}</a>
                                    </td>
                                    <td>{{ cv.position ? cv.position.title : '—' }}</td>
                                    <td>{{ likeCounts[cv.id]|default(0) }}</td>
                                </tr>
                            {% endfor %}
                        {% endif %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    {% endif %}
{% endblock %}
