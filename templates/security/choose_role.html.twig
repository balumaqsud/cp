{% extends 'base.html.twig' %}

{% block title %}{{ 'auth.choose_role'|trans }}{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card">
                <div class="card-body">
                    <h1 class="h4 mb-3">{{ 'auth.choose_role'|trans }}</h1>
                    <p class="text-muted">{{ 'auth.choose_role_help'|trans }}</p>

                    {{ form_start(form) }}
                        {{ form_row(form.role) }}
                        <button type="submit" class="btn btn-primary w-100">{{ 'auth.continue'|trans }}</button>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
