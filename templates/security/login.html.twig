{% extends 'base.html.twig' %}

{% block title %}Log in{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card">
                <div class="card-body">
                    <h1 class="h4 mb-3">Log in</h1>
                    {{ form_start(form) }}
                        {{ form_errors(form) }}
                        {{ form_row(form.email) }}
                        {{ form_row(form.password) }}
                        {{ form_row(form.rememberMe) }}
                        <button type="submit" class="btn btn-primary w-100">Log in</button>
                    {{ form_end(form) }}

                    <div class="d-grid gap-2 mt-3">
                        <a class="btn btn-outline-secondary" href="{{ path('connect_google_start') }}">Continue with Google</a>
                        <a class="btn btn-outline-secondary" href="{{ path('connect_github_start') }}">Continue with GitHub</a>
                    </div>
                    <p class="mt-3 mb-0"><a href="{{ path('app_register') }}">Sign up</a></p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
