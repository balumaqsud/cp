{% extends 'base.html.twig' %}

{% block title %}Log in{% endblock %}

{% block body %}
    <h1>Log in Form </h1>

   {{ form_start(form)}}
        {{ form_row(form.email) }}
        {{ form_row(form.password) }}
        {{ form_row(form.rememberMe)}}

        <button type="submit">LOGIN</button>
    {{ form_end(form) }}

{% endblock %}
