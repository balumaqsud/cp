{% extends 'base.html.twig' %}

{% block body %}
    <h1>Create account</h1>

    {{ form_start(form) }}
        {{ form_row(form.name) }}
        {{ form_row(form.email) }}
        {{ form_row(form.password) }}
        {{ form_row(form.passwordConfirm) }}
        {{ form_row(form.role) }}

        <button type="submit">Register</button>
    {{ form_end(form) }}

    <a href="{{ path('app_login') }}">Already have an account?</a>
{% endblock %}

