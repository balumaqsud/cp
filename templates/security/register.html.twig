{% extends 'base.html.twig' %}

{% block title %}Sign up{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card">
                <div class="card-body">
                    <h1 class="h4 mb-3">Create account</h1>

                    {{ form_start(form) }}
                        {{ form_row(form.name) }}
                        {{ form_row(form.email) }}
                        {{ form_row(form.password) }}
                        {{ form_row(form.passwordConfirm) }}
                        {{ form_row(form.role) }}

                        <button type="submit" class="btn btn-primary w-100">Register</button>
                    {{ form_end(form) }}

                    <p class="mt-3 mb-0"><a href="{{ path('app_login') }}">Already have an account?</a></p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
