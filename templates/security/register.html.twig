{% extends 'base.html.twig' %}

{% block title %}{{ 'nav.register'|trans }}{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card">
                <div class="card-body">
                    <h1 class="h4 mb-3">{{ 'auth.create_account'|trans }}</h1>

                    {{ form_start(form) }}
                        {{ form_row(form.name) }}
                        {{ form_row(form.email) }}
                        {{ form_row(form.password) }}
                        {{ form_row(form.passwordConfirm) }}
                        {{ form_row(form.role) }}

                        <button type="submit" class="btn btn-primary w-100">{{ 'nav.register'|trans }}</button>
                    {{ form_end(form) }}

                    <div class="d-grid gap-2 mt-3">
                        <a class="btn btn-outline-secondary" href="{{ path('connect_google_start') }}">{{ 'auth.google'|trans }}</a>
                        <a class="btn btn-outline-secondary" href="{{ path('connect_github_start') }}">{{ 'auth.github'|trans }}</a>
                    </div>
                    <p class="mt-3 mb-0"><a href="{{ path('app_login') }}">{{ 'auth.have_account'|trans }}</a></p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
