{% extends 'base.html.twig' %}

{% block title %}{{ 'support.heading'|trans }}{% endblock %}

{% block body %}
    <h1 class="h4 mb-3">{{ 'support.heading'|trans }}</h1>

    <div class="row">
        <div class="col-lg-6">
            <p class="text-muted">{{ 'support.help_text'|trans }}</p>

            {{ form_start(form, {attr: {class: 'mt-3'}}) }}
                {{ form_row(form.summary) }}
                {{ form_row(form.priority) }}
                <button type="submit" class="btn btn-primary">{{ 'attribute.save'|trans }}</button>
                <a class="btn btn-outline-secondary" href="{{ returnLink }}">{{ 'attribute.cancel'|trans }}</a>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
